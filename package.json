{
  "name": "twinos",
  "version": "0.1.0",
  "private": true,
  "description": "TwinOS — a consent-based human digital twin that measurably predicts, explains and stress-tests your decisions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "eval": "vitest run --config vitest.evals.config.ts",
    "eval:smoke": "vitest run --config vitest.evals.config.ts evals/smoke",
    "db:types": "supabase gen types typescript --local > src/types/db.ts"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  }
}
