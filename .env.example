# Copy to .env.local (or paste into Vercel → Settings → Environment Variables) and fill in.
# Never commit real values. Comments stay on their own lines so dashboard pastes stay clean.
# Empty values count as "not set".

# Optional: defaults to the Vercel deployment URL, then http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Supabase → Project Settings → API Keys (publishable = browser, secret = server-only).
# The Vercel Supabase integration's NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI (server-only)
OPENAI_API_KEY=
TWIN_MODEL_PRIMARY=gpt-5
TWIN_MODEL_FAST=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_AGENTS_DISABLE_TRACING=0
# minimal | low | medium | high — low ≈ 9 s/prediction on gpt-5
TWIN_REASONING_EFFORT=low
TWIN_REALTIME_MODEL=

# Security. 32+ random bytes each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPROVAL_HMAC_SECRET=
CRON_SECRET=

# Rate limit + budget
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TWIN_DAILY_TOKEN_BUDGET=200000

# Mode. Empty = auto: live when OpenAI + Supabase keys are set, otherwise demo fixtures.
# 1 = always demo (no keys needed, data in memory). 0 = always live (missing keys are an error).
TWIN_MOCK=
# reserved, not implemented yet
TWIN_REPLAY=0

# optional
COMPOSIO_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
