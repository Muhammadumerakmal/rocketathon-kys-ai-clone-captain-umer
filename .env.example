# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (new key model: publishable = browser, secret = server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI (server-only)
OPENAI_API_KEY=
TWIN_MODEL_PRIMARY=gpt-5
TWIN_MODEL_FAST=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_AGENTS_DISABLE_TRACING=0
TWIN_REALTIME_MODEL=

# Security
APPROVAL_HMAC_SECRET=        # 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CRON_SECRET=

# Rate limit + budget
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TWIN_DAILY_TOKEN_BUDGET=200000

# 1 = every AI route returns fixtures (no keys needed). Replay = recorded real outputs for the Aria demo.
TWIN_MOCK=1
TWIN_REPLAY=0

# optional
COMPOSIO_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
